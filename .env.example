# Copy this file to .env.local and fill in real values.
# Never commit real secrets — only this file with placeholder names is tracked in git.

# --- Database (Neon Postgres, or any Postgres-compatible connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public URL of the deployed app (used for invite links, metadata, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Clerk — https://clerk.com) ---
# From your Clerk app's Configure -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Our /login page hosts Clerk's <SignIn/> component directly — these tell
# Clerk (and clerkMiddleware's auth.protect()) to route there instead of a
# Clerk-hosted page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# --- Google Sheets sync (service account) ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the \n escape sequences literal; the app converts them to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
