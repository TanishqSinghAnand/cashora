# Copy this file to .env.local and fill in real values.
# Never commit real secrets — only this file with placeholder names is tracked in git.

# --- Database (Neon Postgres, or any Postgres-compatible connection string) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random 32+ byte secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of the deployed app (used for invite links, metadata, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email OTP sign-in (SMTP) ---
# A dedicated mailbox, not your personal account — e.g. a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords), not
# the account's real password (raw password SMTP login is blocked by every
# major provider now). Port 587 = STARTTLS, 465 = implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cashora <you@example.com>"

# --- Google Sheets sync (service account) ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the \n escape sequences literal; the app converts them to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
